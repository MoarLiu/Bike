{
  "tools": [
    {
      "name": "append_children",
      "title": "Append Children",
      "description": "向文档根部或指定父节点批量追加子节点。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "requestId": {
            "description": "Live dry-run 返回的请求身份，用于确认和幂等查询",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expectedRevision": {
            "type": "string",
            "minLength": 1,
            "description": "调用方读取到的 workspace revision"
          },
          "dryRun": {
            "default": true,
            "description": "默认 true；false 时才真实落盘",
            "type": "boolean"
          },
          "reason": {
            "default": "",
            "description": "写入原因，用于快照和审计摘要",
            "type": "string",
            "maxLength": 300
          },
          "writeTimestamp": {
            "description": "UTC ISO 写入时间；dry-run confirmationArgs 会自动生成，普通调用无需手写",
            "type": "string"
          },
          "documentId": {
            "type": "string",
            "minLength": 1
          },
          "parentNodeId": {
            "type": "string",
            "minLength": 1
          },
          "children": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "maxLength": 10000
                },
                "note": {
                  "type": "string",
                  "maxLength": 50000
                },
                "checked": {
                  "type": "boolean"
                },
                "collapsed": {
                  "type": "boolean"
                },
                "color": {
                  "type": "string",
                  "enum": [
                    "plain",
                    "blue",
                    "green",
                    "amber",
                    "rose"
                  ]
                },
                "codeBlock": {
                  "type": "string",
                  "maxLength": 50000
                },
                "codeLanguage": {
                  "type": "string",
                  "maxLength": 80
                },
                "isTodo": {
                  "type": "boolean"
                },
                "children": {
                  "default": [],
                  "type": "array",
                  "items": {}
                }
              }
            }
          }
        },
        "required": [
          "expectedRevision",
          "documentId",
          "children"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
