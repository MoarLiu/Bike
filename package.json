{
  "name": "bike",
  "version": "2.0.0",
  "private": true,
  "description": "Bike is a local-first outline note and mind map app with optional iCloud Drive backup.",
  "main": "electron/entry.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs server/*.test.mjs mcp/*.test.mjs electron/*.test.mjs",
    "check": "npm test && npm run check:contracts && npm run build && npm run mcp:smoke && git diff --check",
    "check:contracts": "node scripts/check-shared-contracts.mjs",
    "test:runtime": "node scripts/verify-runtime.mjs",
    "test:electron-runtime": "node scripts/verify-runtime.mjs --electron",
    "test:attachments-runtime": "node scripts/verify-attachments.mjs",
    "test:updates-runtime": "node scripts/verify-updates.mjs",
    "auth:hash": "node scripts/hash-password.mjs",
    "setup:sync": "bash scripts/setup-sync-server.sh",
    "mcp:bike": "node mcp/bike-server.mjs",
    "mcp:test": "node --test mcp/*.test.mjs",
    "mcp:smoke": "node mcp/bike-server.smoke.mjs",
    "serve:web": "node server/auth-server.mjs",
    "serve:auth": "npm run serve:web",
    "serve:sync": "node server/sync-server.mjs",
    "start:web": "npm run build && npm run serve:web",
    "start:sync": "npm run serve:sync",
    "start:full": "npm run build && concurrently -k \"npm run serve:web\" \"npm run serve:sync\"",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:start": "vite build && electron .",
    "electron:test": "node --test electron/*.test.mjs",
    "electron:dist:signed": "npm run check && node scripts/build-signed-mac.mjs",
    "electron:dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "test:2.0-runtime": "node scripts/verify-2.0.mjs",
    "test:ui-runtime": "node scripts/verify-ui.mjs",
    "test:compatibility-runtime": "node scripts/verify-compatibility.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "electron-updater": "6.8.11",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.7",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "playwright": "1.65.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.6",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.bike.app",
    "productName": "Bike",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.mjs",
      "mcp/bike-core.mjs",
      "mcp/bike-server.mjs",
      "shared/*.mjs",
      "package.json",
      "mcp/bike-live.mjs"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "MoarLiu",
        "repo": "Bike",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    }
  }
}
